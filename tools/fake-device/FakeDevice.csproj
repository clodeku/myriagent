<Project Sdk="Microsoft.NET.Sdk">

  <!--
    無頭的假裝置（WP3.3 第 14 步，第 3 階段版）：直接用桌面的中樞、帳戶管理員與同步協調者／引擎，對本機的 MyriagentHub 配對、
    跑目錄與用量的劇本、做出積壓。不碰這台電腦真的帳戶（~/.claude、~/.codex）、不執行任何 CLI、不連外網（用量端點是假的）。
    不進 Myriagent.slnx：dotnet build tools/fake-device -c Release
    Runtime/ 的檔案另外以連結編譯進 Myriagent.Tests（第 15 步起：S12 等長情境用同一套元件），所以 slnx 的建置也會編譯它們。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FakeDevice</RootNamespace>
    <AssemblyName>FakeDevice</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 桌面的同步元件都是 internal：Myriagent 與 Myriagent.Protocol 都對 FakeDevice 開了 InternalsVisibleTo -->
    <ProjectReference Include="..\..\src\Myriagent\Myriagent.csproj" />
    <ProjectReference Include="..\..\src\Myriagent.Protocol\Myriagent.Protocol.csproj" />
  </ItemGroup>

</Project>
